# Point the app at your backend.
# Default (falls back automatically when unset): http://localhost:4000
# On a PHYSICAL phone, replace localhost with your PC's LAN IP, e.g.:
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Google Sign-In (optional — the button only appears when at least one ID is set).
# Create OAuth client IDs in Google Cloud Console: see README → Sign in with Google.
# The WEB client ID also powers Expo Go and web builds.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
