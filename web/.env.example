# Web dashboard environment (Vite reads VITE_* vars from .env / .env.local)

# Backend API base — defaults to http://localhost:4000/api when unset.
# VITE_API_URL=http://localhost:4000/api

# Google Sign-In (optional): paste the Web client ID from Google Cloud Console.
# The "Sign in with Google" button appears only when this is set.
# See the repository README → "Sign in with Google".
VITE_GOOGLE_CLIENT_ID=
