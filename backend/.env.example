# RELAY Attendance — backend environment
# Copy this file to .env, or run `npm run setup` which copies it and fills
# random JWT secrets automatically. NEVER commit real secrets.

NODE_ENV=development
PORT=4000

# SQLite for local dev (default). The Docker/Postgres recipe overrides this.
DATABASE_URL="file:./dev.db"

# 64-hex random strings. `npm run setup` generates them for you.
JWT_ACCESS_SECRET=replace-me-with-64-random-hex
JWT_REFRESH_SECRET=replace-me-with-64-random-hex
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Business timezone used for attendance dates and summaries (IANA name)
COMPANY_TZ=Asia/Kolkata

# Where uploaded photos/documents are stored (relative to backend/)
STORAGE_DIR=./storage

MAX_UPLOAD_MB=10
MAX_DOC_UPLOAD_MB=5

# Anti-fraud thresholds
GPS_ACCURACY_MAX_M=50
TIME_DRIFT_MAX_S=600

# Login attempts allowed per IP per 15 minutes (raise for local testing)
LOGIN_RATE_LIMIT_MAX=20

# CORS origin(s), comma separated, or * for all (dev)
CORS_ORIGIN=*
